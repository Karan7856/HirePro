# HirePro AI — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Application
APP_NAME=HirePro AI
APP_VERSION=0.1.0
DEBUG=false

# PostgreSQL
POSTGRES_DB=hirepro
POSTGRES_USER=hirepro_user
POSTGRES_PASSWORD=changeme

# JWT — generate a strong secret with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
